<Project>
  <!--
    The official osu! packages are pinned on purpose. See docs/compatibility-matrix.md before
    changing these: an upgrade invalidates difficulty labels and requires reviewing the golden
    snapshots.
  -->
  <ItemGroup>
    <PackageVersion Include="ppy.osu.Game" Version="2026.916.0" />
    <PackageVersion Include="ppy.osu.Game.Rulesets.Osu" Version="2026.916.0" />
  </ItemGroup>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Security fixes for packages that arrive transitively through ppy.osu.Game (pinned above), raised
      to their first patched release in the same major line. None of them changes what the official
      decoder, the beatmap processor or difficulty compute, so the golden snapshots still hold:
      ImageSharp only decodes textures (headless here, GetBackground throws), and SignalR/MessagePack
      only serve the online client, which nothing in this repository starts.
      - SixLabors.ImageSharp 3.1.11: GHSA-j3p4-wp97-rph4, -j9gm-c75j-xc9q, -jjfr-hcj7-qf5w,
        -v76p-62qx-wwq2, -gwg2-r3hj-4w44, -wmxv-xphr-5c9g (fixed in 3.2.0)
      - Microsoft.AspNetCore.SignalR.Common / .Protocols.MessagePack 10.0.12: GHSA-334f-vvp4-7g6p,
        GHSA-86xp-94pg-8r6r (fixed in 10.0.13)
      - MessagePack 3.1.8: GHSA-qhrr-8q5h-9q3h (fixed in 3.1.9)
      Remove these pins when the pinned osu! release brings the fixed versions itself.
    -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.14" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.NUnit" Version="12.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="NAudio" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>
</Project>

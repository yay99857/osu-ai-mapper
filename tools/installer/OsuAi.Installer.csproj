<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>osu-ai-mapper-setup</AssemblyName>
    <ApplicationIcon>../../apps/desktop/Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
  </PropertyGroup>
  <!--
    build.ps1 publishes the desktop app, zips it and passes the zip and the install settings here;
    a plain build of the solution compiles the installer without them (it then refuses to run).
  -->
  <ItemGroup Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(InstallSettings)' != '' And Exists('$(InstallSettings)')">
    <EmbeddedResource Include="$(InstallSettings)" LogicalName="install.json" />
  </ItemGroup>
</Project>

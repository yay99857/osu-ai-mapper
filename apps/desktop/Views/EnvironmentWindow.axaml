<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OsuAi.Desktop.ViewModels"
        x:Class="OsuAi.Desktop.Views.EnvironmentWindow"
        x:DataType="vm:EnvironmentViewModel"
        Icon="avares://osu-ai-mapper/Assets/app.ico"
        Title="Verificar ambiente — osu-ai-mapper"
        Width="820" Height="600" MinWidth="560" MinHeight="400">

  <DockPanel Margin="16,8,16,12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button Content="Verificar de novo" Command="{Binding RunCommand}" DockPanel.Dock="Right" />
      <TextBlock Text="O que a geração usa nesta máquina: ferramentas, Mapperatorinator, pesos, disco e memória"
                 Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Checks}" Margin="0,0,12,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CheckRow">
            <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="6" Padding="10" Margin="0,6,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" FontSize="16" FontWeight="Bold" Width="24" VerticalAlignment="Top"
                           Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" />
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Fix}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasFix}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>

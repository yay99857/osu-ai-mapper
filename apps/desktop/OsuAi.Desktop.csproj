<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>osu-ai-mapper</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!--
      Two builds: net10.0-windows plays audio through NAudio (WinMM), net10.0 runs on Linux and macOS
      and plays through mpv (Services/AudioPlayer.cs). Pick one with -f when running or publishing.
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <!-- Lets Linux build the Windows target too, so the lock file stays the same on every OS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OsuAi.Desktop.Tests" />
    <AvaloniaResource Include="Assets/app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
    <PackageReference Include="NAudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\packages\application\OsuAi.Application.csproj" />
  </ItemGroup>
</Project>
